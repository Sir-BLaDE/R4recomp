pfx 1
# R4 2026: tuning view of the lighting chain (lighting.pfx): what its "hdr" pass keeps as light.
#  u_sun: sun uv (dominant light direction projected by the camera), in front (0/1), strength
#  u_race: speed (0..1), vanishing point (uv), in a race (0/1)
# No mask and no depth: the chain changes nothing in the game's rendering (those inputs enable
# primitive classification and the stencil); the race HUD is drawn afterwards.

pass hdr
  shader hdr.glsl
  input u_c source_down
  scale 0.5
  format rgba16f
  uniform u_threshold 0.82 0.92
  uniform u_gain 5.0 0.06

pass final
  shader show_mask.glsl
  input u_c source
  input u_e hdr
