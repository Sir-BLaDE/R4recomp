pfx 1
# R4 2026: modern lighting anchored on the game (src/mods/r4_car_effects.cpp sets u_sun and u_race).
#  u_sun: sun uv (dominant light direction projected by the camera), in front (0/1), strength
#  u_race: speed (0..1), vanishing point (uv), in a race (0/1)
# Multi-scale HDR bloom (13-tap downsamples / tent upsamples), god rays from the sun and bright
# lights, anamorphic streaks, light reflections on the road, high-speed light trails, lens flare,
# reflections on the player's car body and colour grading. No mask and no depth (the followed car
# is not in the PGXP depth: analytic volume, reflections.glsl). Turn the engine's built-in bloom
# off ([video] bloom = 0): it doubled this glow, with a low threshold, on all geometry (buildings).
# The race HUD is drawn afterwards. Intermediate passes at half resolution or less.

pass hdr
  shader hdr.glsl
  input u_c source_down
  scale 0.5
  format rgba16f
  uniform u_threshold 0.85 0.94
  uniform u_gain 3.5 0.03

# glow and exposure smoothed over time (lights no longer flicker)
pass stable
  shader stable.glsl
  input u_e hdr
  input u_h history
  scale 0.5
  format rgba16f
  uniform u_k 0.4 0.08
  uniform u_race 0 0.5 0.5 0

pass d1
  shader reduce.glsl
  input u_e stable
  scale 0.25
  format rgba16f

pass d2
  shader reduce.glsl
  input u_e d1
  scale 0.125
  format rgba16f

pass d3
  shader reduce.glsl
  input u_e d2
  scale 0.0625
  format rgba16f

pass d4
  shader reduce.glsl
  input u_e d3
  scale 0.03125
  format rgba16f

pass u3
  shader upsample.glsl
  input u_e d3
  input u_b d4
  scale 0.0625
  format rgba16f
  uniform u_radius 1.0
  uniform u_weight 1.0

pass u2
  shader upsample.glsl
  input u_e d2
  input u_b u3
  scale 0.125
  format rgba16f
  uniform u_radius 1.0
  uniform u_weight 1.0

pass rays
  shader rays.glsl
  input u_c source_down
  input u_m d4
  scale 0.25
  format rgba16f
  uniform u_sun 0.5 1.5 0 0
  uniform u_race 0 0.5 0.5 0
  uniform u_decay 0.965 0.95
  uniform u_strength 0.9 0.6

pass streaks
  shader streaks.glsl
  input u_e d1
  input u_h history
  input u_c source_down
  input u_m d4
  scale 0.25
  format rgba16f
  uniform u_race 0 0.5 0.5 0
  uniform u_k 0.5 1.0 0.6 0.4

pass light
  shader light.glsl
  input u_e d1
  input u_b u2
  input u_r rays
  input u_s streaks
  scale 0.25
  format rgba16f
  uniform u_k 0.3 0.8 1.0 2.0
  uniform u_race 0 0.5 0.5 0

# car body reflections: blurred surroundings, then a clear coat on the player's car
pass env
  shader env.glsl
  input u_c source_down
  scale 0.125
  format rgba8

pass reflections
  shader reflections.glsl
  input u_c source
  input u_env env
  format rgba8
  uniform u_vo 0 0 0 0
  uniform u_vr 1 0 0 0
  uniform u_vu 0 -1 0 0
  uniform u_vf 0 0 1 0
  uniform u_vp 160 120 290 320
  uniform u_vl 0 -1 0 0
  uniform u_k 1.0 1.3 0.12 0

pass final
  shader final.glsl
  input u_c reflections
  input u_l light
  uniform u_sun 0.5 1.5 0 0
  uniform u_flare 1.0
  uniform u_grade 0.12 0.15 0.5 0.18
